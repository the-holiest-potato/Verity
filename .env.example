# Environment Configuration for Verity 2.0
# Copy this file to .env and fill in your actual API keys.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Hugging Face Model Repository (Required for Streamlit Cloud / remote deployment)
# If models/verity-distilroberta is not present locally, model weights are loaded from this HF repo.
# Example: VERITY_MODEL_REPO=username/verity-distilroberta
VERITY_MODEL_REPO=

# Hugging Face Access Token (Optional: only needed if model repository is private)
HF_TOKEN=
